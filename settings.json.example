{
  "theme": "dark",
  "tuiMode": "fullscreen",
  "fullscreenScrollbar": "auto",
  "defaultProjectTrust": "always",
  "packages": [
    "./packages/pi-interactive-subagents",
    "npm:pi-one-ui",
    "npm:@fradser/pi-btw",
    "npm:pi-mcp-adapter",
    "npm:pi-gpt-search",
    "npm:context-mode",
    "npm:@cortexkit/pi-magic-context",
    "npm:@ogulcancelik/pi-herdr",
    "npm:pi-rtk-optimizer",
    "npm:@narumitw/pi-goal@0.54.5"
  ],
  "skills": [
    "!lark-*"
  ],
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 20000
  },
  "defaultProvider": "DDDD",
  "defaultModel": "deepseek-v4.1-flash",
  "defaultThinkingLevel": "high",
  "enabledModels": [
    "DDDD/gpt-6-luna:max",
    "DDDD/grok-4.7:medium",
    "DDDD/deepseek-v4.1-flash:high",
    "DDDD/gpt-6-astra:medium",
    "DDDD/gpt-6-sol:high"
  ]
}
