run-history.jsonl
session-manager-config.toml
pi-crash.log
*.log

# Dependencies / generated environments
node_modules/
**/node_modules/
.venv/
**/.venv/

# Python junk
__pycache__/
**/__pycache__/
*.pyc

# OS/editor junk
.DS_Store
Thumbs.db
tmp/
